DATABASE_URL=postgresql://tt_copilot:tt_copilot_dev@localhost:5432/tt_copilot
REDIS_URL=redis://localhost:6379
NODE_ENV=development
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Required for encrypting the Anthropic API key stored in the database.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be exactly 64 hex characters (32 bytes). Never share or commit this value.
API_KEY_ENCRYPTION_SECRET=your-64-hex-char-secret-here

# ANTHROPIC_API_KEY is no longer set here.
# Configure it through the application Settings page (/settings) instead.
# It is encrypted and stored in the database at runtime.

# ── Risk scoring (optional) ──────────────────────────────────────────────
# The Overall Risk Score is calculated by the application from structured
# rules — never by the LLM. Weights and thresholds are configurable here as a
# partial JSON override; anything omitted keeps its default. Defaults are:
#
#   weights: minorUnresolvedFinding 10, majorUnresolvedFinding 25,
#            criticalUnresolvedFinding 40, observationUnresolvedFinding 0,
#            failedMandatoryCheck 20, missingMandatoryEvidence 20,
#            openBlockingAction 20, overdueAction 10,
#            unclosedPriorGateAction 15
#   thresholds (lower bound of each band): medium 30, high 60, critical 80
#   cap: 100
#
# The effective configuration is always readable at GET /api/risk/config.
# Example — halve a minor finding's weight and start High at 50:
# RISK_SCORING_CONFIG={"weights":{"minorUnresolvedFinding":5},"thresholds":{"high":50}}
